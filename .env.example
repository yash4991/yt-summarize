# Copy this file to .env and fill in your values. Never commit .env.

# --- LLM (required) ---------------------------------------------------------
# Key for the provider in LLM_MODEL (GOOGLE_API_KEY also works for Gemini).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Any CrewAI-supported model. Examples:
#   gemini/gemini-2.5-flash       (default: fast and cheap)
#   anthropic/claude-sonnet-5-5   (set ANTHROPIC_API_KEY)
#   openai/gpt-...                (set OPENAI_API_KEY)
LLM_MODEL=gemini/gemini-2.5-flash

# --- Output -----------------------------------------------------------------
OUTPUT_DIR=output
CACHE_DIR=.cache
# Extra formats besides the .txt files: md, pdf, notion (comma-separated)
EXPORTS=md,pdf

# --- Quality gate -----------------------------------------------------------
# Rewrite once if the reviewer's faithfulness score is below this (1-10)
MIN_FAITHFULNESS=8
MAX_REVISIONS=1

# --- Long videos ------------------------------------------------------------
# Transcripts longer than this many characters are condensed in chunks first
MAX_TRANSCRIPT_CHARS=240000
CHUNK_CHARS=60000

# --- Non-English videos -----------------------------------------------------
# No English subtitles? Use these languages instead (in order), then translate
# them to clean English with the LLM. Comma-separated codes, e.g. hi or hi,mr
SUBTITLE_LANGUAGES=hi
TRANSLATE_CHUNK_CHARS=15000
# No subtitles at all? Let Gemini watch the video and transcribe + translate it.
# Needs GEMINI_API_KEY even if LLM_MODEL is not a Gemini model.
TRANSCRIBE_FALLBACK=true
TRANSCRIBE_MODEL=gemini-2.5-flash
TRANSCRIBE_WINDOW_SECONDS=900

# --- Notion (optional) ------------------------------------------------------
# Create an integration at https://www.notion.so/my-integrations, share a page
# with it, and paste that page's id here.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Show agent reasoning in the console
CREW_VERBOSE=false
