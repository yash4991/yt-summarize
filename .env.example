# Copy this file to .env and fill in your values. Never commit .env.

# --- LLM (required) ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Any CrewAI-supported model. Examples:
#   anthropic/claude-sonnet-5-5   (default: best quality / cost balance)
#   anthropic/claude-haiku-5-5    (cheapest, fastest)
#   openai/gpt-...                (set OPENAI_API_KEY instead)
LLM_MODEL=anthropic/claude-sonnet-5-5

# --- Output -----------------------------------------------------------------
OUTPUT_DIR=output
CACHE_DIR=.cache
# Extra formats besides the .txt files: md, pdf, notion (comma-separated)
EXPORTS=md,pdf

# --- Quality gate -----------------------------------------------------------
# Rewrite once if the reviewer's faithfulness score is below this (1-10)
MIN_FAITHFULNESS=8
MAX_REVISIONS=1

# --- Long videos ------------------------------------------------------------
# Transcripts longer than this many characters are condensed in chunks first
MAX_TRANSCRIPT_CHARS=240000
CHUNK_CHARS=60000

# --- Notion (optional) ------------------------------------------------------
# Create an integration at https://www.notion.so/my-integrations, share a page
# with it, and paste that page's id here.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Show agent reasoning in the console
CREW_VERBOSE=false
